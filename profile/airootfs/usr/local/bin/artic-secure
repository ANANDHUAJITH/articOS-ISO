#!/usr/bin/env bash
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  artic-secure  —  articOs Security Hardening Tool                       │
# │  One-command security baseline + audit                                  │
# └─────────────────────────────────────────────────────────────────────────┘
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info() { echo -e "${CYAN}${BOLD}[secure]${RESET} $*"; }
ok()   { echo -e "${GREEN}✓${RESET} $*"; }
warn() { echo -e "${YELLOW}⚠${RESET} $*"; }
err()  { echo -e "${RED}✗${RESET} $*" >&2; }

## ── Kernel Hardening ─────────────────────────────────────────────────────────
harden_kernel() {
    info "Applying kernel hardening (sysctl)..."
    cat | sudo tee /etc/sysctl.d/99-artic-harden.conf > /dev/null << 'SYSCTL'
## articOs Security Hardening — kernel parameters
## Network
net.ipv4.tcp_syncookies = 1
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.icmp_ignore_bogus_error_responses = 1
net.ipv4.tcp_timestamps = 0
## Kernel
kernel.dmesg_restrict = 1
kernel.kptr_restrict = 2
kernel.yama.ptrace_scope = 1
kernel.unprivileged_bpf_disabled = 1
net.core.bpf_jit_harden = 2
kernel.kexec_load_disabled = 1
kernel.unprivileged_userns_clone = 0
## Memory
kernel.randomize_va_space = 2
vm.mmap_rnd_bits = 32
vm.mmap_rnd_compat_bits = 16
## FS
fs.protected_hardlinks = 1
fs.protected_symlinks = 1
fs.protected_fifos = 2
fs.protected_regular = 2
fs.suid_dumpable = 0
SYSCTL
    sudo sysctl --system >/dev/null 2>&1
    ok "Kernel hardening applied"
}

## ── AppArmor ─────────────────────────────────────────────────────────────────
setup_apparmor() {
    info "Configuring AppArmor..."
    sudo systemctl enable --now apparmor

    # Set all loaded profiles to enforce mode
    if command -v aa-enforce &>/dev/null; then
        find /etc/apparmor.d -maxdepth 1 -type f -not -name "*.disabled" | while read -r f; do
            sudo aa-enforce "$f" 2>/dev/null || true
        done
        ok "AppArmor profiles set to enforce"
    fi

    # Enable audit logging
    sudo systemctl enable --now auditd 2>/dev/null || true
    ok "AppArmor enabled"
}

## ── Firewall ─────────────────────────────────────────────────────────────────
setup_firewall() {
    info "Configuring UFW firewall..."
    sudo ufw --force reset
    sudo ufw default deny incoming
    sudo ufw default allow outgoing
    sudo ufw allow ssh comment "SSH"
    sudo ufw limit ssh comment "SSH rate limit"
    sudo ufw --force enable
    ok "UFW firewall enabled (deny incoming, allow outgoing, SSH rate-limited)"
}

## ── SSH Hardening ────────────────────────────────────────────────────────────
harden_ssh() {
    info "Hardening SSH..."
    local sshd_conf="/etc/ssh/sshd_config.d/99-artic-harden.conf"
    cat | sudo tee "$sshd_conf" > /dev/null << 'SSHD'
## articOs SSH Hardening
Protocol 2
PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PermitEmptyPasswords no
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
MaxAuthTries 3
LoginGraceTime 30
ClientAliveInterval 300
ClientAliveCountMax 2
IgnoreRhosts yes
HostbasedAuthentication no
UseDNS no
Banner /etc/issue.net
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org
SSHD
    echo "Unauthorized access prohibited. All activity is monitored." | \
        sudo tee /etc/issue.net > /dev/null
    sudo systemctl reload sshd 2>/dev/null || true
    ok "SSH hardened"
}

## ── Fail2ban ─────────────────────────────────────────────────────────────────
setup_fail2ban() {
    info "Configuring fail2ban..."
    command -v fail2ban-server &>/dev/null || sudo pacman -S --needed --noconfirm fail2ban

    cat | sudo tee /etc/fail2ban/jail.d/artic.conf > /dev/null << 'F2B'
[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
backend  = systemd

[sshd]
enabled  = true
port     = ssh
filter   = sshd
maxretry = 3
bantime  = 24h
F2B
    sudo systemctl enable --now fail2ban
    ok "fail2ban configured and enabled"
}

## ── Firejail Defaults ────────────────────────────────────────────────────────
setup_firejail() {
    info "Setting up Firejail application sandboxing..."
    command -v firejail &>/dev/null || sudo pacman -S --needed --noconfirm firejail

    # Sandbox common browsers automatically
    for app in firefox chromium; do
        if [[ -f "/usr/bin/${app}" ]]; then
            sudo firecfg --fix 2>/dev/null || true
        fi
    done
    ok "Firejail enabled for browsers"
}

## ── Secure Boot / TPM ────────────────────────────────────────────────────────
check_secureboot() {
    info "Checking Secure Boot status..."
    if command -v mokutil &>/dev/null; then
        mokutil --sb-state 2>/dev/null || warn "mokutil: cannot query Secure Boot"
    else
        warn "mokutil not installed — install to manage Secure Boot keys"
    fi

    if [[ -d /sys/class/tpm ]]; then
        ok "TPM device detected"
        if command -v tpm2_getcap &>/dev/null; then
            tpm2_getcap properties-fixed 2>/dev/null | grep -E "TPMVendorID|specLevel" || true
        fi
    else
        warn "No TPM detected"
    fi
}

## ── LUKS / Encryption Check ──────────────────────────────────────────────────
check_encryption() {
    info "Checking disk encryption..."
    if lsblk -o NAME,TYPE,MOUNTPOINT | grep -q crypt; then
        ok "LUKS encryption detected on one or more volumes"
    else
        warn "No LUKS encryption detected. Consider encrypting with cryptsetup."
    fi
}

## ── Audit ────────────────────────────────────────────────────────────────────
do_audit() {
    info "Running security audit (lynis)..."
    if command -v lynis &>/dev/null; then
        sudo lynis audit system --quick
    else
        warn "lynis not installed. Install: sudo pacman -S lynis"
    fi
}

## ── Full Harden ──────────────────────────────────────────────────────────────
do_harden() {
    warn "This will apply all security hardening settings."
    read -rp "Continue? [y/N] " c; [[ "${c,,}" == y ]] || exit 0

    harden_kernel
    setup_apparmor
    setup_firewall
    harden_ssh
    setup_fail2ban
    setup_firejail
    check_secureboot
    check_encryption

    ok "articOs security hardening complete!"
    warn "Review /etc/ssh/sshd_config.d/99-artic-harden.conf — key-only SSH is now enforced."
}

## ── Main ─────────────────────────────────────────────────────────────────────
case "${1:-help}" in
    harden)        do_harden ;;
    kernel)        harden_kernel ;;
    firewall)      setup_firewall ;;
    ssh)           harden_ssh ;;
    apparmor)      setup_apparmor ;;
    fail2ban)      setup_fail2ban ;;
    firejail)      setup_firejail ;;
    audit)         do_audit ;;
    secureboot)    check_secureboot ;;
    encryption)    check_encryption ;;
    help|--help|-h)
        echo "Usage: artic-secure <command>"
        echo "Commands: harden | kernel | firewall | ssh | apparmor | fail2ban | firejail | audit | secureboot | encryption"
        ;;
    *)  echo "Unknown: $1"; exit 1 ;;
esac
