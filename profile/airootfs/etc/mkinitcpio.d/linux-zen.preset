# articOs mkinitcpio preset — linux-zen kernel

ALL_kver="/boot/vmlinuz-linux-zen"
ALL_config="/etc/mkinitcpio.conf"

PRESETS=('default' 'fallback' 'archiso' 'archiso_nvidia')

default_image="/boot/initramfs-linux-zen.img"

fallback_image="/boot/initramfs-linux-zen-fallback.img"
fallback_options="-S autodetect"

archiso_config="/etc/mkinitcpio.conf.d/archiso.conf"
archiso_image="/boot/initramfs-linux-zen-archiso.img"

archiso_nvidia_config="/etc/mkinitcpio.conf.d/archiso-nvidia.conf"
archiso_nvidia_image="/boot/initramfs-linux-zen-nvidia.img"
