#!/usr/bin/env bash
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  artic-box  —  articOs Container & Package Environment Manager          │
# │  Nix-like: reproducible, isolated environments. No root for user pkgs.  │
# │  Backends: distrobox (podman), flatpak, nix (optional)                  │
# │                                                                         │
# │  Usage:                                                                 │
# │    artic-box enter ubuntu          # enter Ubuntu container             │
# │    artic-box create fedora         # create Fedora container            │
# │    artic-box exec ubuntu -- ls     # run command in container           │
# │    artic-box install ubuntu vim    # install pkg via container apt/dnf  │
# │    artic-box export ubuntu firefox # export GUI app to host             │
# │    artic-box env new myenv python  # create isolated Python env         │
# │    artic-box snap ubuntu           # snapshot a container               │
# └─────────────────────────────────────────────────────────────────────────┘
set -euo pipefail

VERSION="1.0.0"
ARTIC_BOX_DIR="${HOME}/.config/artic/boxes"
LOG="${HOME}/.local/share/artic/box.log"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info() { echo -e "${CYAN}${BOLD}[box]${RESET} $*"; }
ok()   { echo -e "${GREEN}✓${RESET} $*"; }
warn() { echo -e "${YELLOW}⚠${RESET} $*"; }
err()  { echo -e "${RED}✗${RESET} $*" >&2; }
die()  { err "$*"; exit 1; }

mkdir -p "$ARTIC_BOX_DIR" "$(dirname "$LOG")"

## ── Image Catalogue ──────────────────────────────────────────────────────────
declare -A BOX_IMAGES=(
    [ubuntu]="ubuntu:22.04"
    [ubuntu23]="ubuntu:23.10"
    [fedora]="fedora:40"
    [debian]="debian:bookworm"
    [opensuse]="opensuse/tumbleweed:latest"
    [kali]="kalilinux/kali-rolling:latest"
    [ros2]="osrf/ros:humble-desktop"
    [cuda]="nvidia/cuda:12.3.0-devel-ubuntu22.04"
    [alpine]="alpine:3.19"
    [void]="voidlinux/voidlinux:latest"
    [nixos]="nixos/nix:latest"
    [arch]="archlinux:latest"
)

resolve_image() {
    local name="$1"
    if [[ -n "${BOX_IMAGES[$name]:-}" ]]; then
        echo "${BOX_IMAGES[$name]}"
    else
        # Assume direct image ref
        echo "$name"
    fi
}

## ── Distrobox Wrappers ───────────────────────────────────────────────────────
box_list() {
    info "Containers:"
    distrobox list 2>/dev/null || echo "No containers found"
    echo ""
    info "Flatpak apps:"
    flatpak list --app --columns=name,application,version 2>/dev/null | head -20
}

box_create() {
    local name="$1"
    local image; image=$(resolve_image "$name")
    local box_name="${2:-$name}"

    info "Creating container '${box_name}' from ${image}..."
    distrobox create \
        --name "$box_name" \
        --image "$image" \
        --home "${HOME}/.config/artic/boxes/${box_name}/home" \
        --yes

    # Save metadata
    echo "$image" > "${ARTIC_BOX_DIR}/${box_name}.image"
    ok "Container '${box_name}' created. Enter with: artic-box enter ${box_name}"
}

box_enter() {
    local name="$1"
    distrobox enter "$name"
}

box_exec() {
    local name="$1"; shift
    distrobox enter "$name" -- "$@"
}

box_install() {
    local box="$1"; shift
    local pkgs=("$@")
    info "Installing ${pkgs[*]} in box '${box}'..."

    # Detect package manager inside box
    local pm
    pm=$(distrobox enter "$box" -- bash -c '
        if command -v apt &>/dev/null; then echo apt
        elif command -v dnf &>/dev/null; then echo dnf
        elif command -v zypper &>/dev/null; then echo zypper
        elif command -v apk &>/dev/null; then echo apk
        elif command -v pacman &>/dev/null; then echo pacman
        else echo unknown; fi
    ')

    case "$pm" in
        apt)    distrobox enter "$box" -- sudo apt-get install -y "${pkgs[@]}" ;;
        dnf)    distrobox enter "$box" -- sudo dnf install -y "${pkgs[@]}" ;;
        zypper) distrobox enter "$box" -- sudo zypper install -y "${pkgs[@]}" ;;
        apk)    distrobox enter "$box" -- sudo apk add "${pkgs[@]}" ;;
        pacman) distrobox enter "$box" -- sudo pacman -S --needed --noconfirm "${pkgs[@]}" ;;
        *)      die "Unknown package manager in box '${box}'" ;;
    esac
}

box_export() {
    local box="$1"
    local app="$2"
    info "Exporting '${app}' from '${box}' to host..."
    distrobox enter "$box" -- distrobox-export --app "$app"
    ok "App '${app}' exported. Should appear in your app launcher."
}

box_export_bin() {
    local box="$1"
    local bin="$2"
    local extra="${3:-}"
    info "Exporting binary '${bin}' from '${box}'..."
    distrobox enter "$box" -- distrobox-export --bin "/usr/bin/${bin}" \
        --export-path "${HOME}/.local/bin" ${extra:+--extra-flags "$extra"}
    ok "Binary '${bin}' available at ~/.local/bin/${bin}"
}

box_remove() {
    local name="$1"
    warn "Remove container '${name}'? This deletes all data inside."
    read -rp "Type the container name to confirm: " confirm
    [[ "$confirm" == "$name" ]] || { info "Aborted."; exit 0; }
    distrobox rm --force "$name"
    rm -f "${ARTIC_BOX_DIR}/${name}.image"
    ok "Container '${name}' removed"
}

box_snapshot() {
    local name="$1"
    local tag="${2:-$(date +%Y%m%d_%H%M%S)}"
    info "Snapshotting container '${name}' as '${name}-snap-${tag}'..."
    distrobox stop "$name" 2>/dev/null || true
    podman container checkpoint "$name" \
        --export "${ARTIC_BOX_DIR}/${name}-snap-${tag}.tar" 2>/dev/null \
    || podman commit "$name" "artic-box-${name}:${tag}"
    ok "Snapshot saved: artic-box-${name}:${tag}"
}

## ── Isolated Dev Environments (like nix-shell / venv) ───────────────────────
env_new() {
    local name="$1"
    local lang="${2:-python}"
    local env_dir="${HOME}/.config/artic/envs/${name}"
    mkdir -p "$env_dir"

    case "$lang" in
        python|py)
            python -m venv "${env_dir}/venv"
            cat > "${env_dir}/activate.sh" << EOF
#!/bin/bash
source ${env_dir}/venv/bin/activate
export ARTIC_ENV_NAME=${name}
export PS1="(artic:${name}) \$PS1"
EOF
            chmod +x "${env_dir}/activate.sh"
            ok "Python env '${name}' created. Activate: source ${env_dir}/activate.sh"
            ;;
        node|nodejs)
            mkdir -p "${env_dir}/node_modules"
            echo '{"name":"'"$name"'","private":true}' > "${env_dir}/package.json"
            cat > "${env_dir}/activate.sh" << EOF
export PATH=${env_dir}/node_modules/.bin:\$PATH
export NODE_PATH=${env_dir}/node_modules
export ARTIC_ENV_NAME=${name}
EOF
            ok "Node env '${name}' created. Activate: source ${env_dir}/activate.sh"
            ;;
        rust)
            rustup toolchain install stable
            cat > "${env_dir}/activate.sh" << EOF
export CARGO_TARGET_DIR=${env_dir}/.cargo-target
export ARTIC_ENV_NAME=${name}
EOF
            ok "Rust env '${name}' ready."
            ;;
        nix)
            command -v nix &>/dev/null || {
                info "Installing Nix (single-user)..."
                sh <(curl -L https://nixos.org/nix/install) --no-daemon
            }
            cat > "${env_dir}/shell.nix" << 'EOF'
{ pkgs ? import <nixpkgs> {} }:
pkgs.mkShell {
  buildInputs = with pkgs; [
    # Add packages here
  ];
}
EOF
            ok "Nix shell env '${name}' at ${env_dir}/shell.nix. Run: nix-shell ${env_dir}/shell.nix"
            ;;
        *)
            die "Unknown language: $lang. Supported: python, node, rust, nix"
    esac
}

env_list() {
    local env_dir="${HOME}/.config/artic/envs"
    if [[ -d "$env_dir" ]]; then
        info "Isolated environments:"
        ls -1 "$env_dir"
    else
        info "No environments yet. Create with: artic-box env new <name> <lang>"
    fi
}

## ── Flatpak Wrappers ─────────────────────────────────────────────────────────
flatpak_search() {
    flatpak search "$1"
}

flatpak_install() {
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    flatpak install -y flathub "$1"
}

## ── Usage ────────────────────────────────────────────────────────────────────
usage() {
    cat << EOF
${BOLD}artic-box${RESET} v${VERSION} — articOs Container & Env Manager

${BOLD}Containers (distrobox):${RESET}
  artic-box list
  artic-box create <name> [box-name]      # name: ubuntu, fedora, kali, ros2…
  artic-box enter <box>
  artic-box exec <box> -- <command>
  artic-box install <box> <pkg...>
  artic-box export <box> <app>            # export GUI app to host
  artic-box export-bin <box> <binary>
  artic-box snapshot <box> [tag]
  artic-box remove <box>

${BOLD}Isolated Envs (like nix-shell):${RESET}
  artic-box env new <name> <lang>         # lang: python, node, rust, nix
  artic-box env list

${BOLD}Flatpak:${RESET}
  artic-box flatpak search <query>
  artic-box flatpak install <app-id>

${BOLD}Available box images:${RESET}
  $(printf '  %s\n' "${!BOX_IMAGES[@]}" | sort)
EOF
}

## ── Main ─────────────────────────────────────────────────────────────────────
case "${1:-}" in
    list|ls)       box_list ;;
    create)        shift; box_create "$@" ;;
    enter)         shift; box_enter "$@" ;;
    exec)          shift; box_exec "$@" ;;
    install)       shift; box_install "$@" ;;
    export)        shift; box_export "$@" ;;
    export-bin)    shift; box_export_bin "$@" ;;
    snapshot|snap) shift; box_snapshot "$@" ;;
    remove|rm|del) shift; box_remove "$@" ;;
    env)
        shift
        case "${1:-}" in
            new)  shift; env_new "$@" ;;
            list) env_list ;;
            *)    die "env subcommand: new | list" ;;
        esac
        ;;
    flatpak)
        shift
        case "${1:-}" in
            search)  shift; flatpak_search "$@" ;;
            install) shift; flatpak_install "$@" ;;
            *)       die "flatpak subcommand: search | install" ;;
        esac
        ;;
    --help|-h|help) usage ;;
    *) usage; exit 1 ;;
esac
