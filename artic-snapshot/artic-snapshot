#!/usr/bin/env bash
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  artic-snapshot  —  articOs Unified Snapshot Manager                    │
# │  Wraps btrfs snapshots, snapper, and timeshift in one CLI.              │
# │  Supports: create, list, restore, delete, auto-schedule, grub-update    │
# └─────────────────────────────────────────────────────────────────────────┘
set -euo pipefail

VERSION="1.0.0"
SNAP_DIR="/.snapshots"
LOG="/var/log/artic-snapshot.log"
BTRFS_SUBVOL_ROOT="/"
SNAPPER_CONFIG="root"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info() { echo -e "${CYAN}${BOLD}[snap]${RESET} $*"; }
ok()   { echo -e "${GREEN}✓${RESET} $*"; }
warn() { echo -e "${YELLOW}⚠${RESET} $*"; }
err()  { echo -e "${RED}✗${RESET} $*" >&2; }
die()  { err "$*"; exit 1; }
log()  { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG"; }

## ── Check btrfs root ─────────────────────────────────────────────────────────
is_btrfs() {
    findmnt -n -o FSTYPE / 2>/dev/null | grep -q btrfs
}

require_btrfs() {
    is_btrfs || die "Root filesystem is not btrfs. Snapshots require btrfs."
}

## ── Backend: snapper ─────────────────────────────────────────────────────────
snapper_create() {
    local desc="${1:-manual}"
    require_btrfs
    sudo snapper -c "$SNAPPER_CONFIG" create \
        --type single \
        --description "$desc" \
        --print-number \
        --cleanup-algorithm timeline
}

snapper_list() {
    sudo snapper -c "$SNAPPER_CONFIG" list
}

snapper_delete() {
    local num="$1"
    sudo snapper -c "$SNAPPER_CONFIG" delete "$num"
}

snapper_restore() {
    local num="$1"
    warn "This will restore snapshot #${num}. A backup snapshot will be taken first."
    read -rp "Continue? [y/N] " confirm
    [[ "${confirm,,}" == y ]] || { info "Aborted."; exit 0; }

    local pre; pre=$(snapper_create "pre-restore-from-${num}")
    ok "Safety snapshot #${pre} created"

    sudo snapper -c "$SNAPPER_CONFIG" undochange "${num}..0"
    ok "Restored to snapshot #${num}"
    sudo update-grub 2>/dev/null || sudo grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || true
}

## ── Backend: timeshift (fallback for ext4) ────────────────────────────────
timeshift_create() {
    local desc="${1:-manual}"
    sudo timeshift --create --comments "$desc" --scripted
}

timeshift_list() {
    sudo timeshift --list
}

timeshift_restore() {
    local snap="$1"
    sudo timeshift --restore --snapshot "$snap" --scripted
}

## ── Unified API ──────────────────────────────────────────────────────────────
do_create() {
    local desc="${1:-manual}"
    local quiet="${2:-false}"
    log "Creating snapshot: $desc"
    if is_btrfs; then
        local num; num=$(snapper_create "$desc")
        [[ "$quiet" == "--quiet" ]] || ok "btrfs snapshot #${num} created: $desc"
        echo "$num"
    else
        timeshift_create "$desc"
        [[ "$quiet" == "--quiet" ]] || ok "timeshift snapshot created: $desc"
    fi
    ## Update grub-btrfs menu
    is_btrfs && sudo /usr/lib/grub-btrfsd/grub-btrfs-create-snapshot 2>/dev/null || true
}

do_list() {
    if is_btrfs; then
        snapper_list
    else
        timeshift_list
    fi
}

do_delete() {
    local target="$1"
    if is_btrfs; then
        snapper_delete "$target"
        ok "Deleted snapshot #${target}"
    else
        warn "For timeshift, delete via: sudo timeshift --delete --snapshot '$target'"
    fi
}

do_restore() {
    local target="$1"
    if is_btrfs; then
        snapper_restore "$target"
    else
        timeshift_restore "$target"
    fi
}

do_setup() {
    info "Setting up artic-snapshot..."

    if is_btrfs; then
        info "btrfs detected — configuring snapper"
        sudo pacman -S --needed --noconfirm snapper snap-pac grub-btrfs 2>/dev/null || true

        # Create snapper config if missing
        if ! sudo snapper -c root list &>/dev/null 2>&1; then
            sudo snapper -c root create-config /
        fi

        # Set reasonable retention
        sudo snapper -c root set-config \
            NUMBER_LIMIT=10 \
            NUMBER_LIMIT_IMPORTANT=5 \
            TIMELINE_CREATE=yes \
            TIMELINE_CLEANUP=yes \
            TIMELINE_LIMIT_HOURLY=3 \
            TIMELINE_LIMIT_DAILY=7 \
            TIMELINE_LIMIT_WEEKLY=4 \
            TIMELINE_LIMIT_MONTHLY=3 \
            TIMELINE_LIMIT_YEARLY=2

        sudo systemctl enable --now snapper-timeline.timer snapper-cleanup.timer
        sudo systemctl enable --now grub-btrfsd.service 2>/dev/null || true
        ok "snapper configured with automatic timeline snapshots"
    else
        info "Non-btrfs detected — using timeshift (rsync mode)"
        sudo pacman -S --needed --noconfirm timeshift 2>/dev/null || true
        sudo timeshift --setup --rsync --scripted || true
        ok "timeshift configured"
    fi

    ## Enable snap-pac hooks (auto-snapshot before pacman)
    sudo pacman -S --needed --noconfirm snap-pac 2>/dev/null || true
    ok "snap-pac installed — pacman ops will auto-snapshot"
}

do_diff() {
    local from="$1" to="${2:-0}"
    require_btrfs
    sudo snapper -c "$SNAPPER_CONFIG" diff "${from}..${to}"
}

do_status() {
    local snap="${1:-}"
    require_btrfs
    if [[ -n "$snap" ]]; then
        sudo snapper -c "$SNAPPER_CONFIG" status "${snap}..0"
    else
        info "Last 5 snapshots:"
        snapper_list | tail -6
    fi
}

## ── Usage ────────────────────────────────────────────────────────────────────
usage() {
    cat << EOF
${BOLD}artic-snapshot${RESET} v${VERSION} — articOs Snapshot Manager

${BOLD}Usage:${RESET}
  artic-snapshot create [description] [--quiet]
  artic-snapshot list
  artic-snapshot restore <number>
  artic-snapshot delete <number>
  artic-snapshot diff <from> [to]
  artic-snapshot status [number]
  artic-snapshot setup          # one-time setup (run after install)

${BOLD}Examples:${RESET}
  artic-snapshot create "before upgrading kernel"
  artic-snapshot list
  artic-snapshot restore 42
  artic-snapshot diff 10 20
EOF
}

## ── Main ─────────────────────────────────────────────────────────────────────
case "${1:-}" in
    create)   shift; do_create "$@" ;;
    list|ls)  do_list ;;
    delete|rm) shift; do_delete "$@" ;;
    restore)  shift; do_restore "$@" ;;
    diff)     shift; do_diff "$@" ;;
    status)   shift; do_status "$@" ;;
    setup)    do_setup ;;
    --help|-h|help) usage ;;
    *) usage; exit 1 ;;
esac
